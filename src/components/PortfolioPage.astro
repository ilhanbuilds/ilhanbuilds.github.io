---
import Base from '../layouts/Base.astro';
import Featured from './projects/Featured.astro';
import ProjectCard from './projects/ProjectCard.astro';
import ProjectChronology from './projects/ProjectChronology.astro';
import { Image } from 'astro:assets';
import { building } from '../data/projects';
import { profile } from '../data/profile';
import { copy, route } from '../i18n';
import type { Locale } from '../types/content';
interface Props {
  locale: Locale;
  page: 'home' | 'work' | 'about' | '404';
}
const { locale, page } = Astro.props;
const t = copy[locale];
const titles = {
  home: profile.name,
  work: t.work,
  about: t.about,
  '404': '404',
};
const descriptions = {
  home: t.homeDescription,
  work: t.projectDescription,
  about: t.aboutDescription,
  '404': t.notFoundBody,
};
const interests =
  locale === 'en'
    ? [
        'Software development',
        'Software testing',
        'Mobile applications',
        'Web development',
        'Machine learning',
        'Computer vision',
        'Artificial intelligence',
      ]
    : [
        'Yazılım geliştirme',
        'Yazılım testi',
        'Mobil uygulamalar',
        'Web geliştirme',
        'Makine öğrenmesi',
        'Bilgisayarlı görü',
        'Yapay zekâ',
      ];
---

<Base
  locale={locale}
  title={titles[page]}
  description={descriptions[page]}
  noindex={page === '404'}
  {...(page === 'work' ? { mainClass: 'work-page' } : {})}
>
  {page === 'home' && (
    <>
      <section class="hero personal-hero">
        <div class="hero-copy">
          <p class="eyebrow">{profile.location[locale]}</p>
          <h1>{profile.name}</h1>
          <p class="hero-role">
            {locale === 'tr'
              ? 'Bilgisayar Mühendisliği öğrencisi'
              : 'Computer Engineering student'}
          </p>
          <p class="hero-intro">{t.intro}</p>
          <div class="hero-actions">
            <a class="button-link" href={profile.resume[locale]} download>
              {t.resume}
            </a>
            <a class="button-link secondary" href={route(locale, 'work')}>
              {locale === 'tr' ? 'Projelerim' : 'My projects'}
            </a>
          </div>
          <div class="hero-links">
            <a
              class="text-link"
              href={profile.github}
              rel="noopener noreferrer"
            >
              GitHub
            </a>
            <a
              class="text-link"
              href={profile.linkedin}
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
            <a
              class="text-link"
              href={`mailto:${profile.developerEmail}`}
              aria-label={`${t.developerContact}: ${profile.developerEmail}`}
            >
              {profile.developerEmail}
            </a>
          </div>
        </div>
        <figure class="home-portrait about-portrait">
          <Image
            src={profile.portrait}
            widths={[160, 240, 400, 600]}
            sizes="(max-width: 767px) 160px, 240px"
            alt={
              locale === 'tr'
                ? 'İlhan Kılıç’ın portresi.'
                : 'Portrait of İlhan Kılıç.'
            }
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </section>
      <section class="section" aria-labelledby="selected-work">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{t.eyebrow}</p>
            <h2 id="selected-work">{t.selected}</h2>
          </div>
          <a class="text-link" href={route(locale, 'work')}>
            {t.allWork}
          </a>
        </div>
        <Featured locale={locale} />
      </section>
      <section class="section currently" aria-labelledby="currently-building">
        <div class="section-side">
          <h2 id="currently-building">{t.currently}</h2>
          <p>{t.currentlyNote}</p>
        </div>
        <div>
          {building.map((p) => (
            <ProjectCard project={p} locale={locale} />
          ))}
        </div>
      </section>
    </>
  )}
  {page === 'work' && (
    <>
      <div class="page-intro">
        <p class="eyebrow">
          {profile.name} / {t.work}
        </p>
        <h1>
          {t.work}
          <span class="accent">.</span>
        </h1>
        <p>{t.workIntro}</p>
      </div>
      <ProjectChronology locale={locale} />
    </>
  )}
  {page === 'about' && (
    <>
      <div class="page-intro">
        <p class="eyebrow">
          {profile.name} / {t.about}
        </p>
        <h1>{t.aboutTitle}</h1>
        <p>{t.aboutIntro}</p>
      </div>
      <div class="about-grid">
        <figure class="about-portrait">
          <Image
            src={profile.portrait}
            alt={
              locale === 'en'
                ? 'Portrait of İlhan Kılıç.'
                : 'İlhan Kılıç’ın portresi.'
            }
            widths={[360, 600, 900]}
            sizes="(max-width: 767px) 85vw, (max-width: 1024px) 40vw, 480px"
            format="webp"
            loading="eager"
          />
        </figure>
        <div class="about-copy">
          <div class="prose">
            <p>{t.aboutBody}</p>
            <p>{t.aboutBody2}</p>
          </div>
          <aside class="about-facts">
            <section>
              <h2>{t.education}</h2>
              <p>{profile.university[locale]}</p>
              <p class="muted">
                {locale === 'en'
                  ? 'Computer Engineering'
                  : 'Bilgisayar Mühendisliği'}
              </p>
            </section>
            <section>
              <h2>{t.contact}</h2>
              <p>{t.contactText}</p>
              <a
                class="text-link"
                href={profile.github}
                rel="noopener noreferrer"
              >
                GitHub / ilhanbuilds
              </a>
              {profile.linkedin && (
                <p>
                  <a href={profile.linkedin} rel="noopener noreferrer">
                    LinkedIn
                  </a>
                </p>
              )}
              <div class="contact-purpose">
                <h3>{t.developerContact}</h3>
                <a href={`mailto:${profile.developerEmail}`}>
                  {profile.developerEmail}
                </a>
              </div>
              <div class="contact-purpose">
                <h3>{t.professionalContact}</h3>
                <a href={`mailto:${profile.professionalEmail}`}>
                  {profile.professionalEmail}
                </a>
              </div>
              <p>
                <a class="text-link" href={profile.resume[locale]} download>
                  {t.resume}
                </a>
              </p>
            </section>
          </aside>
        </div>
      </div>
      <section class="section interests">
        <h2>{t.interests}</h2>
        <ul>
          {interests.map((interest) => (
            <li>{interest}</li>
          ))}
        </ul>
      </section>
    </>
  )}
  {page === '404' && (
    <section class="page-intro not-found">
      <p class="eyebrow">404</p>
      <h1>{t.notFound}</h1>
      <p>{t.notFoundBody}</p>
      <a class="text-link" href={route(locale)}>
        {t.home}
      </a>
    </section>
  )}
</Base>
