---
import Base from '../layouts/Base.astro';
import Featured from './projects/Featured.astro';
import ProjectRow from './projects/ProjectRow.astro';
import Timeline from './journey/Timeline.astro';
import { building, timeline, projects } from '../data/projects';
import { profile } from '../data/profile';
import { copy, route } from '../i18n';
import type { Locale } from '../types/content';
interface Props {
  locale: Locale;
  page: 'home' | 'work' | 'journey' | 'about' | '404';
}
const { locale, page } = Astro.props;
const t = copy[locale];
const titles = {
  home: profile.name,
  work: t.work,
  journey: t.journey,
  about: t.about,
  '404': '404',
};
const descriptions = {
  home: t.homeDescription,
  work: t.projectDescription,
  journey: t.journeyDescription,
  about: t.aboutDescription,
  '404': t.notFoundBody,
};
const interests =
  locale === 'en'
    ? [
        'Software development',
        'Mobile applications',
        'Web development',
        'Machine learning',
        'Computer vision',
        'Artificial intelligence',
      ]
    : [
        'Yazılım geliştirme',
        'Mobil uygulamalar',
        'Web geliştirme',
        'Makine öğrenmesi',
        'Bilgisayarlı görü',
        'Yapay zekâ',
      ];
---

<Base
  locale={locale}
  title={titles[page]}
  description={descriptions[page]}
  noindex={page === '404'}
>
  {page === 'home' && (
    <>
      <section class="hero">
        <div class="hero-kicker">
          <span>{profile.name}</span>
          <span>{profile.location[locale]}</span>
        </div>
        <h1>
          {t.heroLine}
          <br />
          <span>{t.heroEnd}</span>
        </h1>
        <div class="hero-bottom">
          <p class="hero-role">{profile.title[locale]}</p>
          <div>
            <p class="hero-intro">{t.intro}</p>
            <a
              class="text-link"
              href={profile.github}
              rel="noopener noreferrer"
            >
              GitHub / ilhanbuilds
            </a>
          </div>
        </div>
      </section>
      <section class="section" aria-labelledby="selected-work">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{t.eyebrow}</p>
            <h2 id="selected-work">{t.selected}</h2>
          </div>
          <a class="text-link" href={route(locale, 'work')}>
            {t.allWork}
          </a>
        </div>
        <Featured locale={locale} />
      </section>
      <section class="section currently" aria-labelledby="currently-building">
        <div class="section-side">
          <h2 id="currently-building">{t.currently}</h2>
          <p>{t.currentlyNote}</p>
        </div>
        <div>
          {building.map((p) => (
            <ProjectRow project={p} locale={locale} compact />
          ))}
        </div>
      </section>
      <section
        class="section journey-preview"
        aria-labelledby="journey-preview"
      >
        <div>
          <p class="eyebrow">2024 — {timeline.at(-1)?.year}</p>
          <h2 id="journey-preview">
            {t.journeyTitle}
            <br />
            <span>{t.journeyEnd}</span>
          </h2>
          <a class="text-link" href={route(locale, 'journey')}>
            {t.journeyLink}
          </a>
        </div>
        <div class="journey-preview-notes">
          <div>
            <span class="meta">2024 / Python</span>
            <p>{t.start}</p>
          </div>
          <div>
            <span class="meta">2026 / Mobile · ML</span>
            <p>{t.now}</p>
          </div>
        </div>
      </section>
    </>
  )}
  {page === 'work' && (
    <>
      <div class="page-intro">
        <p class="eyebrow">
          {profile.name} / {t.work}
        </p>
        <h1>
          {t.work}
          <span class="accent">.</span>
        </h1>
        <p>{t.workIntro}</p>
      </div>
      <section aria-label={t.selected}>
        <Featured locale={locale} />
      </section>
      <section class="section archive">
        <h2>{t.archive}</h2>
        {[...projects]
          .filter((p) => !p.featured)
          .sort((a, b) => b.timelineOrder - a.timelineOrder)
          .map((p) => (
            <ProjectRow project={p} locale={locale} />
          ))}
      </section>
    </>
  )}
  {page === 'journey' && (
    <>
      <div class="page-intro">
        <p class="eyebrow">2024 — {timeline.at(-1)?.year}</p>
        <h1>
          {t.journey}
          <span class="accent">.</span>
        </h1>
        <p>{t.journeyIntro}</p>
      </div>
      <Timeline locale={locale} />
    </>
  )}
  {page === 'about' && (
    <>
      <div class="page-intro">
        <p class="eyebrow">
          {profile.name} / {t.about}
        </p>
        <h1>{t.aboutTitle}</h1>
        <p>{t.aboutIntro}</p>
      </div>
      <div class="about-grid">
        <div class="prose">
          <p>{t.aboutBody}</p>
          <p>{t.aboutBody2}</p>
        </div>
        <aside class="about-facts">
          <section>
            <h2>{t.education}</h2>
            <p>{profile.university[locale]}</p>
            <p class="muted">
              {locale === 'en'
                ? 'Computer Engineering'
                : 'Bilgisayar Mühendisliği'}
            </p>
          </section>
          <section>
            <h2>{t.contact}</h2>
            <p>{t.contactText}</p>
            <a
              class="text-link"
              href={profile.github}
              rel="noopener noreferrer"
            >
              GitHub / ilhanbuilds
            </a>
            {profile.linkedin && (
              <p>
                <a href={profile.linkedin} rel="noopener noreferrer">
                  LinkedIn
                </a>
              </p>
            )}
            {profile.email && (
              <p>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </p>
            )}
          </section>
        </aside>
      </div>
      <section class="section interests">
        <h2>{t.interests}</h2>
        <ul>
          {interests.map((interest) => (
            <li>{interest}</li>
          ))}
        </ul>
      </section>
    </>
  )}
  {page === '404' && (
    <section class="page-intro not-found">
      <p class="eyebrow">404</p>
      <h1>{t.notFound}</h1>
      <p>{t.notFoundBody}</p>
      <a class="text-link" href={route(locale)}>
        {t.home}
      </a>
    </section>
  )}
</Base>
