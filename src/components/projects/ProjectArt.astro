---
import Screenshot from './Screenshot.astro';
import { promotionalCovers } from '../../data/covers';
import type { Locale, Project } from '../../types/content';
interface Props {
  project: Project;
  locale: Locale;
  loading?: 'eager' | 'lazy';
}
const { project, locale, loading = 'lazy' } = Astro.props;
const promotional = promotionalCovers[project.id]?.[locale];
const image = promotional ?? project.coverImage;
const isComposition = Boolean(promotional) || project.id === 'racker';
---

<figure
  class="project-cover"
  data-cover-kind={
    isComposition ? 'composition' : image ? 'screenshot' : 'typography'
  }
>
  <div class="project-image-frame cover-canvas">
    {image ? (
      <Screenshot image={image} locale={locale} loading={loading} />
    ) : (
      <div class="cover-typography" aria-hidden="true">
        <strong>{project.title}</strong>
        <span>{project.category[locale]}</span>
      </div>
    )}
  </div>
  <figcaption>
    {isComposition
      ? locale === 'en'
        ? 'Promotional composition'
        : 'Tanıtım kompozisyonu'
      : image
        ? locale === 'en'
          ? 'Application screenshot'
          : 'Uygulama ekranı'
        : locale === 'en'
          ? 'Project identity'
          : 'Proje kimliği'}
  </figcaption>
</figure>
<style>
  .project-cover {
    margin: 0;
  }
  .project-cover .cover-canvas {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 2 / 1;
    padding: 0;
    border-radius: 6px;
    background: var(--art-bg);
    overflow: hidden;
  }
  .project-cover :global(.screenshot) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: 0;
  }
  figcaption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .cover-typography {
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
    width: 100%;
    border-left: 3px solid var(--brand-blue);
  }
  .cover-typography strong {
    font-size: clamp(1.3rem, 3vw, 2rem);
    line-height: 1.25;
  }
  .cover-typography span {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
