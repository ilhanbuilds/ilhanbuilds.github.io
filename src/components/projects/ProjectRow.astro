---
import type { Locale, Project } from '../../types/content';
import { copy, route, statuses } from '../../i18n';
interface Props {
  project: Project;
  locale: Locale;
  compact?: boolean;
}
const { project: p, locale, compact = false } = Astro.props;
const t = copy[locale];
---

<article class:list={['project-row', { compact }]}>
  <div>
    <h3>
      <a href={route(locale, `work/${p.slug}`)}>{p.title}</a>
    </h3>
    <p>{p.translations[locale].summary}</p>
    <div class="project-tags">
      {p.status && <span class="status">{statuses[locale][p.status]}</span>}
      {p.collaboration === 'team' && <span>{t.team}</span>}
    </div>
  </div>
  <div class="row-meta">
    <span>{p.year}</span>
    <span>{p.technologies.join(' / ')}</span>
  </div>
</article>
