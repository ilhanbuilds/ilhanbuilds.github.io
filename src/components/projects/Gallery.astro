---
import Icon from '../common/Icon.astro';
import Screenshot from './Screenshot.astro';
import { copy } from '../../i18n';
import type { Locale, ProjectImage } from '../../types/content';

interface Props {
  images: ProjectImage[];
  locale: Locale;
  title?: string;
  note?: string;
}
const { images, locale, title, note } = Astro.props;
const t = copy[locale];
const english = locale === 'en';
---

<section class="section screenshot-gallery" data-gallery>
  <div class="gallery-heading">
    <h2>{title ?? t.screenshots}</h2>
    <p>
      {note ??
        (english
          ? 'Select an image to view it in full.'
          : 'Tam boy görmek için bir görsel seçin.')}
    </p>
  </div>
  <div class="gallery screenshot-grid">
    {images.map((image, index) => (
      <figure>
        <a
          class="gallery-image-link"
          href={image.src.src}
          data-gallery-index={index}
          aria-label={`${t.openImage}: ${image.alt[locale]}`}
        >
          <Screenshot
            image={image}
            locale={locale}
            sizes="(max-width: 599px) 90vw, (max-width: 1023px) 45vw, 30vw"
          />
        </a>
        <figcaption>{image.alt[locale]}</figcaption>
      </figure>
    ))}
  </div>
  <dialog
    class="gallery-lightbox"
    aria-label={title ?? t.screenshots}
    data-gallery-dialog
  >
    <div class="lightbox-toolbar">
      <p class="lightbox-count" aria-live="polite" data-gallery-count></p>
      <button type="button" data-gallery-close autofocus>
        {english ? 'Close' : 'Kapat'}
      </button>
    </div>
    <figure class="lightbox-figure">
      <div
        class:list={['lightbox-stage', { 'has-navigation': images.length > 1 }]}
      >
        {images.length > 1 && (
          <button
            class="lightbox-arrow"
            type="button"
            data-gallery-previous
            aria-label={english ? 'Previous image' : 'Önceki görsel'}
          >
            <Icon name="chevronLeft" />
          </button>
        )}
        <div data-gallery-media></div>
        {images.length > 1 && (
          <button
            class="lightbox-arrow"
            type="button"
            data-gallery-next
            aria-label={english ? 'Next image' : 'Sonraki görsel'}
          >
            <Icon name="chevronRight" />
          </button>
        )}
      </div>
      <figcaption data-gallery-caption></figcaption>
    </figure>
  </dialog>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-gallery]')
    .forEach((gallery) => {
      const dialog = gallery.querySelector<HTMLDialogElement>(
        '[data-gallery-dialog]',
      )!;
      // Keep the anchors' full-size fallback in browsers without native dialogs.
      if (typeof dialog.showModal !== 'function') return;
      const links = [
        ...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-index]'),
      ];
      const media = dialog.querySelector<HTMLElement>('[data-gallery-media]')!;
      const image = document.createElement('img');
      image.dataset.galleryImage = '';
      image.alt = '';
      const caption = dialog.querySelector<HTMLElement>(
        '[data-gallery-caption]',
      )!;
      const count = dialog.querySelector<HTMLElement>('[data-gallery-count]')!;
      let current = 0;
      let opener: HTMLAnchorElement | undefined;
      let previousOverflow = '';

      const showImage = (index: number) => {
        current = (index + links.length) % links.length;
        const link = links[current]!;
        const thumbnail = link.querySelector<HTMLImageElement>('img')!;
        image.src = link.href;
        image.alt = thumbnail.alt;
        image.width = thumbnail.width;
        image.height = thumbnail.height;
        media.replaceChildren(image);
        caption.textContent = thumbnail.alt;
        count.textContent = `${current + 1} / ${links.length}`;
      };
      links.forEach((link, index) => {
        link.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          event.preventDefault();
          opener = link;
          showImage(index);
          previousOverflow = document.body.style.overflow;
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        });
      });
      dialog
        .querySelector('[data-gallery-close]')!
        .addEventListener('click', () => dialog.close());
      dialog
        .querySelector('[data-gallery-previous]')
        ?.addEventListener('click', () => showImage(current - 1));
      dialog
        .querySelector('[data-gallery-next]')
        ?.addEventListener('click', () => showImage(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Tab') {
          const buttons = [
            ...dialog.querySelectorAll<HTMLButtonElement>(
              'button:not(:disabled)',
            ),
          ].filter((button) => button.getClientRects().length > 0);
          if (buttons.length === 0) return;
          const currentIndex = buttons.findIndex(
            (button) => button === document.activeElement,
          );
          const nextIndex =
            currentIndex === -1
              ? event.shiftKey
                ? buttons.length - 1
                : 0
              : (currentIndex + (event.shiftKey ? -1 : 1) + buttons.length) %
                buttons.length;
          event.preventDefault();
          buttons[nextIndex]!.focus();
        }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          showImage(current + (event.key === 'ArrowRight' ? 1 : -1));
        }
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        image.removeAttribute('src');
        media.replaceChildren();
        opener?.focus({ preventScroll: true });
      });
    });
</script>

<style>
  .screenshot-gallery {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .gallery-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    flex-wrap: wrap;
  }
  .gallery-heading h2 {
    margin: 0;
  }
  .gallery-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .screenshot-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  .screenshot-grid figure {
    min-width: 0;
  }
  .screenshot-grid .gallery-image-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: 0.75rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition:
      border-color 160ms,
      transform 160ms;
  }
  .screenshot-grid .gallery-image-link:hover {
    outline: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .screenshot-grid :global(.screenshot) {
    position: absolute;
    inset: 0.75rem;
    width: calc(100% - 1.5rem);
    height: calc(100% - 1.5rem);
    max-width: calc(100% - 1.5rem);
    max-height: calc(100% - 1.5rem);
    object-fit: contain;
    border-radius: 3px;
  }
  .screenshot-grid figcaption {
    font-size: 0.875rem;
    line-height: 1.5;
    margin-top: 0.625rem;
  }
  .gallery-lightbox {
    box-sizing: border-box;
    width: min(90rem, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1rem;
    color: var(--text);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 10px;
    overscroll-behavior: contain;
  }
  .gallery-lightbox::backdrop {
    background: rgb(0 0 0 / 78%);
  }
  .lightbox-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .lightbox-count {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .gallery-lightbox button {
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .gallery-lightbox button:hover {
    border-color: var(--accent);
  }
  .lightbox-stage {
    display: grid;
    align-items: center;
    gap: 0.5rem;
  }
  .lightbox-stage.has-navigation {
    grid-template-columns: 44px minmax(0, 1fr) 44px;
  }
  .gallery-lightbox .lightbox-arrow {
    width: 44px;
    padding: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .lightbox-figure {
    margin: 0.75rem 0;
  }
  .lightbox-figure :global(img) {
    display: block;
    width: 100%;
    height: min(68dvh, 64rem);
    object-fit: contain;
  }
  .lightbox-figure figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  @media (max-width: 63.99rem) {
    .screenshot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 37.49rem) {
    .screenshot-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .gallery-lightbox {
      padding: 0.75rem;
    }
    .lightbox-figure :global(img) {
      height: 58dvh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screenshot-grid .gallery-image-link {
      transition: none;
    }
    .screenshot-grid .gallery-image-link:hover {
      transform: none;
    }
  }
</style>
