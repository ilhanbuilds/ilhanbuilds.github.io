---
import { copy, route, statuses } from '../../i18n';
import type { Locale, Project } from '../../types/content';
import ProjectArt from './ProjectArt.astro';
interface Props {
  project: Project;
  locale: Locale;
  loading?: 'eager' | 'lazy';
}
const { project: p, locale, loading = 'lazy' } = Astro.props;
const t = copy[locale];
---

<article class:list={['project-card', `card-${p.id}`]} data-project={p.id}>
  <div class="card-cover">
    <ProjectArt project={p} locale={locale} loading={loading} />
  </div>
  <div class="card-content">
    <div class="card-topline">
      <span>{p.category[locale]}</span>
      <span>{p.year}</span>
    </div>
    <h3>
      <a class="card-main-link" href={route(locale, `work/${p.slug}`)}>
        {p.title}
      </a>
    </h3>
    <p class="project-summary">{p.translations[locale].summary}</p>
    <div class="project-tags">
      {p.technologies.map((technology) => (
        <span>{technology}</span>
      ))}
    </div>
    <div class="card-bottom">
      <div class="project-tags">
        {p.status && <span class="status">{statuses[locale][p.status]}</span>}
        {p.collaboration === 'team' && <span>{t.team}</span>}
      </div>
      <div class="card-actions">
        <a
          class="text-link"
          href={route(locale, `work/${p.slug}`)}
          aria-label={`${t.viewProject}: ${p.title}`}
        >
          {t.viewProject}
        </a>
        {p.storeUrl && (
          <a class="text-link" href={p.storeUrl} rel="noopener noreferrer">
            {t.store}
          </a>
        )}
        {p.demoUrl && (
          <a class="text-link" href={p.demoUrl} rel="noopener noreferrer">
            {t.demo}
          </a>
        )}
      </div>
    </div>
  </div>
</article>
