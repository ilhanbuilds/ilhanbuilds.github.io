---
import { featured } from '../../data/projects';
import { copy, route, statuses } from '../../i18n';
import type { Locale } from '../../types/content';
import StoreLink from './StoreLink.astro';
import ProjectArt from './ProjectArt.astro';
import Screenshot from './Screenshot.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<div class="featured-grid">
  {featured.map((p) => (
    <article
      class:list={[
        'featured-project',
        p.featured === 1 ? 'primary-project' : 'secondary-project',
      ]}
    >
      <a class="art-link" href={route(locale, `work/${p.slug}`)}>
        <ProjectArt project={p} locale={locale} />
      </a>
      <div class="project-info">
        <div class="project-heading">
          {p.logo && (
            <span class="project-logo">
              <Screenshot image={p.logo} locale={locale} sizes="56px" />
            </span>
          )}
          {p.storeUrl ? (
            <div class="featured-product-identity">
              <h3>
                <a href={route(locale, `work/${p.slug}`)}>{p.title}</a>
              </h3>
              <span class="meta">{p.category[locale]}</span>
              <StoreLink href={p.storeUrl} locale={locale} subtle />
            </div>
          ) : (
            <>
              <h3>
                <a href={route(locale, `work/${p.slug}`)}>{p.title}</a>
              </h3>
              <span class="meta">{p.category[locale]}</span>
            </>
          )}
        </div>
        <p class="project-summary">{p.translations[locale].summary}</p>
        <div class="project-tags">
          {p.status && <span class="status">{statuses[locale][p.status]}</span>}
          {p.collaboration === 'team' && <span>{t.team}</span>}
          <span>{p.technologies.join(' / ')}</span>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .featured-product-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }
</style>
