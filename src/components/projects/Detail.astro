---
import StoreLink from './StoreLink.astro';
import ProductFeatures from './ProductFeatures.astro';
import Screenshot from './Screenshot.astro';
import DemoShell from '../demos/DemoShell.astro';
import SecureCompare from '../demos/SecureCompare.astro';
import SyncDemo from '../demos/SyncDemo.astro';
import ProjectNavigation from './ProjectNavigation.astro';
import Icon from '../common/Icon.astro';
import Base from '../../layouts/Base.astro';
import Gallery from './Gallery.astro';
import { copy, route, statuses } from '../../i18n';
import type { Locale, Project } from '../../types/content';
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project: p } = Astro.props;
const t = copy[locale];
const content = p.translations[locale];
const sections = [
  [t.overview, content.overview],
  [t.process, content.process],
  [t.technicalDetails, content.technicalDetails],
  [t.lessons, content.lessons],
];
const gallery = [
  ...(p.storeGallery ?? []),
  ...(p.id === 'rubikrl' ? [] : [p.coverImage]),
  ...(p.gallery ?? []),
].filter((image): image is NonNullable<typeof image> => Boolean(image));
---

<Base locale={locale} title={p.title} description={content.summary}>
  <div class:list={['detail-intro', `detail-${p.id}`]}>
    <div class="detail-lead">
      <a
        class="detail-back button-link secondary"
        data-project-back
        href={route(locale, 'work')}
      >
        <Icon name="arrowLeft" />
        {locale === 'en' ? 'Back to projects' : 'Projelere dön'}
      </a>
      <div class="project-tags">
        <span>{p.category[locale]}</span>
        {p.status && <span class="status">{statuses[locale][p.status]}</span>}
      </div>
      <h1>{p.title}</h1>
      <p class="detail-summary">{content.summary}</p>
      <ul class="detail-technologies" aria-label={t.technologies}>
        {p.technologies.map((technology) => (
          <li>{technology}</li>
        ))}
      </ul>
    </div>
    <div
      class:list={[
        'detail-identity',
        { 'racker-product-identity': p.id === 'racker' },
      ]}
      aria-hidden={p.id === 'racker' ? undefined : 'true'}
    >
      {p.logo ? (
        <span class="detail-logo">
          <Screenshot
            image={p.logo}
            locale={locale}
            sizes="96px"
            loading="eager"
          />
        </span>
      ) : (
        <span class="identity-name">{p.title}</span>
      )}
      {p.id === 'racker' && <strong class="product-name">Racker</strong>}
      <span class="meta">{p.category[locale]}</span>
      {p.id === 'racker' && p.storeUrl && (
        <>
          <span class="meta">Android · Wear OS</span>
          <StoreLink href={p.storeUrl} locale={locale} />
        </>
      )}
    </div>
  </div>
  <div class="detail-grid">
    <aside>
      <dl class="project-facts">
        <div>
          <dt>{t.year}</dt>
          <dd>{p.year}</dd>
        </div>
        {p.collaboration && (
          <div>
            <dt>{t.collaboration}</dt>
            <dd>{p.collaboration === 'team' ? t.team : t.solo}</dd>
          </div>
        )}
      </dl>
      <div class="detail-links">
        {p.storeUrl && p.id !== 'racker' && (
          <a class="text-link" href={p.storeUrl} rel="noopener noreferrer">
            {t.store}
          </a>
        )}
        {p.repositoryUrl && (
          <a class="text-link" href={p.repositoryUrl} rel="noopener noreferrer">
            {t.repository}
          </a>
        )}
        {p.documentationUrl && (
          <a
            class="text-link"
            href={p.documentationUrl}
            rel="noopener noreferrer"
          >
            {t.documentation}
          </a>
        )}
        {p.demoUrl && (
          <a class="text-link" href={p.demoUrl} rel="noopener noreferrer">
            {t.demo}
          </a>
        )}
        {p.visibility === 'private' && <span class="meta">{t.private}</span>}
      </div>
    </aside>
    <div class="prose">
      {sections
        .filter(([, text]) => text)
        .map(([heading, text], index) => (
          <section>
            <h2>{heading}</h2>
            <p>{text}</p>
            {index === 0 && p.productFeatures && (
              <ProductFeatures features={p.productFeatures[locale]} />
            )}
          </section>
        ))}
    </div>
  </div>
  <DemoShell id={p.id} locale={locale} />
  {p.id === 'secureface' && <SecureCompare locale={locale} />}
  {(p.id === 'racker' || p.id === 'bilekten') && (
    <SyncDemo locale={locale} kind={p.id} />
  )}
  {gallery.length > 0 && (
    <Gallery
      images={gallery}
      locale={locale}
      {...(p.id === 'racker'
        ? {
            title:
              locale === 'en' ? 'Application screens' : 'Uygulama ekranları',
            note:
              locale === 'en'
                ? 'Current Google Play screenshots, followed by the previously supplied interface compositions.'
                : 'Güncel Google Play ekranları ve ardından daha önce paylaşılan arayüz kompozisyonları.',
          }
        : {})}
    />
  )}
  <ProjectNavigation project={p} locale={locale} />
</Base>
<style>
  .racker-product-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .racker-product-identity .detail-logo {
    margin: 0;
  }
  .racker-product-identity .product-name {
    font-size: 1.25rem;
  }
  .racker-product-identity .meta {
    line-height: 1.4;
  }

  .detail-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    font-size: 0.85rem;
  }
</style>
