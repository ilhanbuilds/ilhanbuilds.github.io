---
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sayfa taşındı · ilhanbuilds</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target }}>
      try {
        localStorage.setItem('locale', 'tr');
      } catch {
        /* The destination still works without storage. */
      }
      location.replace(target + location.search + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${target}`} />
    </noscript>
  </head>
  <body>
    <p>
      Bu sayfa taşındı. <a href={target}>Yeni adreste devam edin.</a>
    </p>
  </body>
</html>
