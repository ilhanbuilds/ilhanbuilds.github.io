---
interface Props {
  target: string;
  locale?: 'tr' | 'en';
}
const { target, locale = 'tr' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{locale === 'en' ? 'Page moved' : 'Sayfa taşındı'} · ilhanbuilds</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target, locale }}>
      try {
        localStorage.setItem('locale', locale);
      } catch {
        /* The destination still works without storage. */
      }
      location.replace(target + location.search + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${target}`} />
    </noscript>
  </head>
  <body>
    <p>
      {locale === 'en' ? 'This page has moved.' : 'Bu sayfa taşındı.'}
      <a href={target}>
        {locale === 'en'
          ? 'Continue at the new address.'
          : 'Yeni adreste devam edin.'}
      </a>
    </p>
  </body>
</html>
