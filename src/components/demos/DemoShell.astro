---
import type { Locale } from '../../types/content';
interface Props {
  id: string;
  locale: Locale;
}
const { id, locale } = Astro.props;
const english = locale === 'en';
const demos: Record<
  string,
  { path: string; title: string; description: string }
> = {
  idleoyun: {
    path: 'idleoyun',
    title: 'IdleOyun',
    description: english
      ? 'The original menus, clicker and market adapted for the browser. Demo accounts exist only in this frame’s memory; progress is cleared when leaving or reloading the page.'
      : 'Özgün menüler, tıklama oyunu ve marketin tarayıcı uyarlaması. Demo hesaplar yalnızca bu çerçevenin belleğinde tutulur; sayfadan ayrılınca veya sayfa yenilenince ilerleme silinir.',
  },
  calculator: {
    path: 'calculator',
    title: english ? 'Calculator' : 'Hesap makinesi',
    description: english
      ? 'The original layout and integer arithmetic behavior, adapted from C# for the browser.'
      : 'Özgün C# arayüzü ve tam sayı hesaplama davranışının tarayıcı uyarlaması.',
  },
  hcjeditor: {
    path: 'hcjeditor',
    title: 'HCJEditor',
    description: english
      ? 'Try HTML, CSS and JavaScript in an isolated live preview. File operations are disabled and edits are cleared when leaving.'
      : 'HTML, CSS ve JavaScript’i yalıtılmış canlı ön izlemede deneyin. Dosya işlemleri kapalıdır; sayfadan ayrılınca düzenlemeler silinir.',
  },
  rubikrl: {
    path: 'cube',
    title: english
      ? 'Interactive cube simulation'
      : 'Etkileşimli küp simülasyonu',
    description: english
      ? 'An independently written cube preview: turn faces, rotate the view, shuffle and reset. No model or AI solver runs here.'
      : 'Bağımsız yazılmış küp ön izlemesi: yüzleri çevirin, görünümü döndürün, karıştırın ve sıfırlayın. Burada model veya AI çözücü çalışmaz.',
  },
};
const demo = demos[id];
---

{demo && (
  <section
    class="section demo-section"
    data-demo
    data-path={`/demos/${demo.path}.html?lang=${locale}`}
    data-kind={id}
  >
    <h2>{demo.title}</h2>
    <p class="demo-description">{demo.description}</p>
    <div class="demo-host demo-surface" data-demo-host></div>
    <noscript>
      <p>
        {english
          ? 'JavaScript is required for this interactive preview.'
          : 'Bu etkileşimli ön izleme için JavaScript gereklidir.'}
      </p>
    </noscript>
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((section) => {
    const host = section.querySelector<HTMLElement>('[data-demo-host]')!;
    const load = () => {
      if (host.children.length) return;
      const frame = document.createElement('iframe');
      const url = new URL(section.dataset.path!, location.origin);
      url.searchParams.set(
        'theme',
        document.documentElement.dataset.theme ?? 'light',
      );
      frame.src = url.href;
      frame.title = section.querySelector('h2')!.textContent!;
      frame.sandbox.add('allow-scripts');
      frame.referrerPolicy = 'no-referrer';
      frame.className = `demo-frame demo-frame-${section.dataset.kind}`;
      host.replaceChildren(frame);
      if (section.dataset.kind === 'rubikrl') {
        const pointers = new Set<number>();
        let pendingHeight: number | undefined;
        const applyHeight = () => {
          if (pointers.size || pendingHeight === undefined) return;
          host.style.setProperty(
            '--demo-height',
            `${Math.ceil(pendingHeight)}px`,
          );
          section.dataset.fitted = 'true';
          pendingHeight = undefined;
        };
        document.addEventListener('pointerdown', (event) =>
          pointers.add(event.pointerId),
        );
        const release = (event: PointerEvent) => {
          pointers.delete(event.pointerId);
          setTimeout(applyHeight, 0);
        };
        document.addEventListener('pointerup', release);
        document.addEventListener('pointercancel', release);
        window.addEventListener('message', (event: MessageEvent<unknown>) => {
          if (
            event.source !== frame.contentWindow ||
            typeof event.data !== 'object' ||
            event.data === null
          )
            return;
          const data = event.data as Record<string, unknown>;
          if (
            data.type === 'portfolio-cube-height' &&
            typeof data.height === 'number' &&
            Number.isFinite(data.height) &&
            data.height >= 250 &&
            data.height <= 1800
          ) {
            pendingHeight = data.height;
            applyHeight();
          }
        });
      }
      frame.addEventListener(
        'load',
        () => {
          section.dataset.loaded = 'true';
        },
        { once: true },
      );
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            load();
            observer.disconnect();
          }
        },
        { rootMargin: '240px' },
      );
      observer.observe(host);
    } else load();
  });
</script>
<style>
  .demo-section {
    margin-block: 1.5rem;
    padding-block: 1.5rem;
  }
  .demo-section h2 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
  }
  .demo-description {
    margin-block: 0.65rem 1rem;
  }
  .demo-host {
    --demo-height: 660px;
    min-height: var(--demo-height);
    max-width: 60rem;
    margin-inline: auto;
  }
  [data-kind='calculator'] .demo-host {
    --demo-height: 590px;
    max-width: 360px;
  }
  [data-kind='idleoyun'] .demo-host {
    max-width: 580px;
  }
  [data-kind='hcjeditor'] .demo-host {
    --demo-height: 600px;
  }
  [data-kind='rubikrl'] .demo-host {
    --demo-height: 550px;
  }
  .demo-host :global(.demo-frame) {
    height: var(--demo-height);
    margin-top: 0;
    border: 0;
  }
  @media (max-width: 47.99rem) {
    [data-kind='hcjeditor'] .demo-host {
      --demo-height: 720px;
    }
    [data-kind='rubikrl'] .demo-host {
      --demo-height: 660px;
    }
  }
</style>
