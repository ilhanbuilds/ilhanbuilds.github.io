---
import { projectImages } from '../../data/project-images';
import type { Locale } from '../../types/content';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const english = locale === 'en';
const source = projectImages.secureface.coverImage.src.src;
---

<section class="section secure-comparison">
  <h2>
    {english
      ? 'Before / after anonymization'
      : 'Anonimleştirme öncesi / sonrası'}
  </h2>
  <p class="demo-description">
    {english
      ? 'Interactive comparison from the approved recorded screenshot. This does not run live face detection or encryption.'
      : 'Onaylı kayıtlı ekran görüntüsünden etkileşimli karşılaştırma. Canlı yüz tespiti veya şifreleme çalıştırmaz.'}
  </p>
  <div data-compare data-source={source}>
    <div class="compare-stage" style="--reveal:50%">
      <div
        class="compare-layer compare-after"
        role="img"
        aria-label={
          english ? 'Recorded anonymized face' : 'Kayıtlı anonimleştirilmiş yüz'
        }
      ></div>
      <div
        class="compare-layer compare-before"
        role="img"
        aria-label={english ? 'Original face' : 'Özgün yüz'}
      ></div>
      <span class="compare-divider" aria-hidden="true"></span>
      <span class="compare-label before">{english ? 'Before' : 'Önce'}</span>
      <span class="compare-label after">{english ? 'After' : 'Sonra'}</span>
    </div>
    <label class="compare-control">
      {english ? 'Original image visibility' : 'Özgün görüntünün görünürlüğü'}
      <input type="range" min="0" max="100" value="50" />
    </label>
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-compare]')
    .forEach((comparison) => {
      const stage = comparison.querySelector<HTMLElement>('.compare-stage')!;
      const range = comparison.querySelector<HTMLInputElement>('input')!;
      const load = () =>
        stage.style.setProperty(
          '--compare-source',
          `url("${comparison.dataset.source}")`,
        );
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              load();
              observer.disconnect();
            }
          },
          { rootMargin: '240px' },
        );
        observer.observe(stage);
      } else load();
      range.addEventListener('input', () =>
        stage.style.setProperty('--reveal', `${range.value}%`),
      );
    });
</script>
<style>
  .secure-comparison {
    margin-block: 1.5rem;
    padding-block: 1.5rem;
  }
  .secure-comparison h2 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
  }
  .demo-description {
    margin-block: 0.65rem 1rem;
  }
  .compare-stage {
    width: min(100%, 22rem);
    margin-top: 0;
  }
  .compare-control {
    max-width: 22rem;
  }
</style>
