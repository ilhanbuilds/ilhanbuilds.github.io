---
import Screenshot from '../projects/Screenshot.astro';
import type { Locale, Project } from '../../types/content';
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const english = locale === 'en';
---

<section class="section product-preview">
  <h2>
    {english
      ? 'Explore the real app screens'
      : 'Gerçek uygulama ekranlarını inceleyin'}
  </h2>
  <p class="demo-description">
    {english
      ? 'Browse the supplied Android and Wear OS compositions. This is an image preview, not a running application.'
      : 'Sağlanan Android ve Wear OS kompozisyonları arasında geçiş yapın. Bu, çalışan uygulama değil, görsel ön izlemedir.'}
  </p>
  <details data-product-preview>
    <summary>
      {english ? 'Open product preview' : 'Ürün ön izlemesini aç'}
    </summary>
    <div class="product-preview-controls">
      <button type="button" data-prev>
        {english ? 'Previous' : 'Önceki'}
      </button>
      <span data-count aria-live="polite"></span>
      <button type="button" data-next>
        {english ? 'Next' : 'Sonraki'}
      </button>
    </div>
    <div data-slides></div>
    <template>
      {project.gallery?.map((image) => (
        <figure>
          <Screenshot image={image} locale={locale} />
          <figcaption>{image.alt[locale]}</figcaption>
        </figure>
      ))}
    </template>
  </details>
</section>
<script>
  document
    .querySelectorAll<HTMLDetailsElement>('[data-product-preview]')
    .forEach((details) => {
      const host = details.querySelector<HTMLElement>('[data-slides]')!;
      let active = 0;
      const update = () => {
        const slides = [...host.querySelectorAll<HTMLElement>('figure')];
        slides.forEach((slide, index) => {
          slide.hidden = index !== active;
        });
        details.querySelector('[data-count]')!.textContent =
          `${active + 1} / ${slides.length}`;
      };
      details.addEventListener('toggle', () => {
        if (details.open && !host.children.length) {
          host.append(
            details
              .querySelector<HTMLTemplateElement>('template')!
              .content.cloneNode(true),
          );
          update();
        }
      });
      details.querySelector('[data-prev]')!.addEventListener('click', () => {
        active = (active - 1 + host.children.length) % host.children.length;
        update();
      });
      details.querySelector('[data-next]')!.addEventListener('click', () => {
        active = (active + 1) % host.children.length;
        update();
      });
    });
</script>
