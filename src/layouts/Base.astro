---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { profile } from '../data/profile';
import { copy, alternate } from '../i18n';
import type { Locale } from '../types/content';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  mainClass?: string;
}
const {
  locale,
  title,
  description,
  noindex = false,
  mainClass = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} · ilhanbuilds`;
const shareImage = new URL(`/branding/v1.1.1/og-${locale}.png`, Astro.site);
const shareAlt =
  locale === 'tr'
    ? 'ilhanbuilds — Kişisel Portfolyo; proje vitrini ve mavi marka kimliği.'
    : 'ilhanbuilds — Personal Portfolio; project showcase and blue brand identity.';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.href,
  sameAs: [profile.github, profile.linkedin].filter(Boolean),
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: profile.university[locale],
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          /* System preference is the fallback when storage is unavailable. */
        }
        document.documentElement.dataset.theme =
          theme === 'dark' || theme === 'light'
            ? theme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        try {
          const currentLocale = document.documentElement.lang;
          const savedLocale = localStorage.getItem('locale');
          if (location.pathname === '/' && savedLocale === 'en') {
            location.replace('/en/' + location.search + location.hash);
          } else {
            localStorage.setItem('locale', currentLocale);
          }
        } catch {
          /* Explicit localized URLs remain usable without storage. */
        }
        document.addEventListener('click', (event) => {
          const link =
            event.target instanceof Element
              ? event.target.closest('a[data-locale]')
              : null;
          const selectedLocale = link?.getAttribute('data-locale');
          if (selectedLocale === 'tr' || selectedLocale === 'en') {
            try {
              localStorage.setItem('locale', selectedLocale);
            } catch {
              /* Follow the ordinary language link. */
            }
          }
        });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#F5F4F0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111111"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(alternate(Astro.url.pathname, 'en'), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="tr"
          href={new URL(alternate(Astro.url.pathname, 'tr'), Astro.site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternate(Astro.url.pathname, 'tr'), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'tr_TR'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'en' ? 'tr_TR' : 'en_US'}
    />
    <meta property="og:site_name" content="ilhanbuilds" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy[locale].skip}
    </a>
    <Header locale={locale} />
    <main id="main" class:list={['wrap', mainClass]} tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const key = 'portfolio-work-position';
      const restoreKey = 'portfolio-work-restore';
      const workPath = location.pathname.startsWith('/en/')
        ? '/en/work/'
        : '/work/';
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>('a[href]');
        if (
          !link ||
          event.defaultPrevented ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        try {
          if (
            location.pathname === workPath &&
            link.origin === location.origin &&
            link.pathname.startsWith(workPath) &&
            link.pathname !== workPath
          )
            sessionStorage.setItem(
              key,
              JSON.stringify({ path: workPath, y: window.scrollY }),
            );
          if (link.hasAttribute('data-project-back'))
            sessionStorage.setItem(restoreKey, workPath);
        } catch {
          /* Browsing without session storage still follows ordinary links. */
        }
      });
      try {
        if (
          location.pathname === workPath &&
          sessionStorage.getItem(restoreKey) === workPath
        ) {
          sessionStorage.removeItem(restoreKey);
          const position: unknown = JSON.parse(
            sessionStorage.getItem(key) ?? 'null',
          );
          if (
            position &&
            typeof position === 'object' &&
            'path' in position &&
            position.path === workPath &&
            'y' in position &&
            typeof position.y === 'number' &&
            Number.isFinite(position.y)
          ) {
            const y = position.y;
            document.fonts.ready.then(() =>
              requestAnimationFrame(() => window.scrollTo(0, y)),
            );
          }
        }
      } catch {
        /* A missing or invalid position uses the default page position. */
      }
    </script>
  </body>
</html>
