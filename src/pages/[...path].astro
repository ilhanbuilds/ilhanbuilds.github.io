---
import type { GetStaticPaths } from 'astro';
import PortfolioPage from '../components/PortfolioPage.astro';
import Detail from '../components/projects/Detail.astro';
import { projects } from '../data/projects';
import type { Locale, Project } from '../types/content';
import LegacyRedirect from '../components/navigation/LegacyRedirect.astro';

export const getStaticPaths = (() => {
  const localized = (['tr', 'en'] as const).flatMap((locale) => {
    const prefix = locale === 'en' ? 'en/' : '';
    const pages = (['work', 'journey', 'about'] as const).map((page) => ({
      params: { path: `${prefix}${page}` },
      props: { locale, page },
    }));
    const details = projects.map((project) => ({
      params: { path: `${prefix}work/${project.slug}` },
      props: { locale, project },
    }));
    return [
      ...pages,
      ...details,
      ...(locale === 'en'
        ? [
            { params: { path: 'en' }, props: { locale, page: 'home' } },
            { params: { path: 'en/404' }, props: { locale, page: '404' } },
          ]
        : []),
    ];
  });
  const legacy = [
    '',
    'work',
    'journey',
    'about',
    '404',
    ...projects.map((project) => `work/${project.slug}`),
  ].map((path) => ({
    params: { path: `tr${path ? `/${path}` : ''}` },
    props: {
      locale: 'tr',
      legacyTarget: path === '404' ? '/404.html' : `/${path ? `${path}/` : ''}`,
    },
  }));
  return [...localized, ...legacy];
}) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
  page?: 'home' | 'work' | 'journey' | 'about' | '404';
  project?: Project;
  legacyTarget?: string;
}
const { locale, page, project, legacyTarget } = Astro.props;
---

{legacyTarget ? (
  <LegacyRedirect target={legacyTarget} />
) : project ? (
  <Detail locale={locale} project={project} />
) : (
  page && <PortfolioPage locale={locale} page={page} />
)}
